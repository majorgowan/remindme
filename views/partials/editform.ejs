<div class="formdiv">
    <p class="prompt"><%= prompt %></p>
    <form action="/lodge<%= locals.edit ? `?resaveId=${reminderId}` : '' %>" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="reminder_raw" value="<%= processed.raw %>">
        <div>
            <label for="reminder_text">Reminder:</label>
            <input class="remindmeinput" type="text" value="<%= processed.what %>" id="reminder_text" name="reminder_text">
        </div>
        <div>
            <label for="reminder_date">Date:</label>
            <input class="remindmeinput" type="date" value="<%= processed.date %>" id="reminder_date" name="reminder_date">
        </div>
        <div>
            <label for="reminder_time">Time:</label>
            <input class="remindmeinput" type="time" value="<%= processed.time %>" id="reminder_time" name="reminder_time">
        </div>
        <div>
            <label for="repeat_select">Repeat:</label>
            <select class="remindmeselect" class="select" id="repeat_select" name="repeat_select">
                <option value="never"
                <% if (processed.repeat && processed.repeat.trim() === "never") { %>
                        selected
                        <% } %>>
                    Never
                </option>
                <option value="daily"
                <% if (processed.repeat && processed.repeat.trim() === "daily") { %>
                        selected
                        <% } %>>
                    Daily
                </option>
                <option value="weekly"
                <% if (processed.repeat && processed.repeat.trim() === "weekly") { %>
                        selected
                        <% } %>>
                    Weekly
                </option>
                <option value="monthly"
                <% if (processed.repeat && processed.repeat.trim() === "monthly") { %>
                        selected
                        <% } %>>
                    Monthly
                </option>
            </select>
        </div>
        <div id="frequency_div" class="<%- (processed.repeat === "never") ? "hiddeninput" : "" %>">
            <label for="reminder_frequency">Frequency:</label>
            <input class="remindmeinput" type="number" value="<%- processed.repeat !== "never" ? processed.frequency : "" %>" id="reminder_frequency"
                   name="reminder_frequency">
        </div>
        <div id="numberoftimes_div" class="<%- (processed.repeat === "never") ? "hiddeninput" : "" %>">
            <label for="reminder_numberoftimes">Number of Times:</label>
            <input class="remindmeinput" type="number"
                   value="<%- processed.numberOfTimes ? processed.numberOfTimes : "" %>"
                   id="reminder_numberoftimes" name="reminder_numberoftimes"
                   placeholder="<%- !processed.numberOfTimes || processed.numberOfTimes <= 0 ? "never ends" : "" %>">
        </div>
        <div id="daysofweek_div" class="checkboxwrapper <%- (processed.repeat === "never") ? "hiddeninput" : "" %>">
            <label>Days of Week:</label>
            <div class="checkboxinput">
                <label class="checkboxlabel">
                    <input type="checkbox" id="daysofweek_cb_su" name="dayofweek_cb_su" value="su"
                           <%= (processed.daysOfWeek && processed.daysOfWeek.includes("su")) ? "checked" : "" %>
                    >
                    <span>S</span>
                </label>
                <label class="checkboxlabel">
                    <input type="checkbox" id="daysofweek_cb_mo" name="dayofweek_cb_mo" value="mo"
                           <%= (processed.daysOfWeek && processed.daysOfWeek.includes("mo")) ? "checked" : "" %>
                    >
                    <span>M</span>
                </label>
                <label class="checkboxlabel">
                    <input type="checkbox" id="daysofweek_cb_tu" name="dayofweek_cb_tu" value="tu"
                            <%= (processed.daysOfWeek && processed.daysOfWeek.includes("tu")) ? "checked" : "" %>
                    >
                    <span>T</span>
                </label>
                <label class="checkboxlabel">
                    <input type="checkbox" id="daysofweek_cb_we" name="dayofweek_cb_we" value="we"
                            <%= (processed.daysOfWeek && processed.daysOfWeek.includes("we")) ? "checked" : "" %>
                    >
                    <span>W</span>
                </label>
                <label class="checkboxlabel">
                    <input type="checkbox" id="daysofweek_cb_th" name="dayofweek_cb_th" value="th"
                            <%= (processed.daysOfWeek && processed.daysOfWeek.includes("th")) ? "checked" : "" %>
                    >
                    <span>T</span>
                </label>
                <label class="checkboxlabel">
                    <input type="checkbox" id="daysofweek_cb_fr" name="dayofweek_cb_fr" value="fr"
                            <%= (processed.daysOfWeek && processed.daysOfWeek.includes("fr")) ? "checked" : "" %>
                    >
                    <span>F</span>
                </label>
                <label class="checkboxlabel">
                    <input type="checkbox" id="daysofweek_cb_sa" name="dayofweek_cb_sa" value="sa"
                            <%= (processed.daysOfWeek && processed.daysOfWeek.includes("sa")) ? "checked" : "" %>
                    >
                    <span>S</span>
                </label>
            </div>
        </div>
        <div id="daysofmonth_div" class="<%- (processed.repeat === "monthly") ? "" : "hiddeninput" %>">
            <label for="reminder_dayofmonth">Days of Month:</label>
            <input class="remindmeinput" type="string" value="<%- processed.daysOfMonth ? processed.daysOfMonth.join(",") : "" %>" id="reminder_daysofmonth"
                   name="reminder_daysofmonth">
        </div>
        <div id="setposition_div" class="<%- (processed.repeat === "monthly") ? "" : "hiddeninput" %>">
            <label for="reminder_setposition" title="e.g. use -1 for last of month">Month Position:</label>
            <input class="remindmeinput" type="string" value="<%- processed.setPosition ? processed.setPosition.join(",") : "" %>" id="reminder_setposition"
                   name="reminder_setposition">
        </div>
        <div>
            <label for="urgency_select">Urgency:</label>
            <select class="select remindmeselect" id="urgency_select" name="urgency_select">
                <option value="not urgent"
                <% if (processed.urgency && processed.urgency.trim() === "not urgent") { %>
                        selected
                        <% } %>>
                    Not urgent
                </option>
                <option value="urgent"
                <% if (processed.urgency && processed.urgency.trim() === "urgent") { %>
                        selected
                        <% } %>>
                    Urgent
                </option>
                <option value="very urgent"
                <% if (processed.urgency && processed.urgency.trim() === "very urgent") { %>
                        selected
                        <% } %>>
                    Very urgent
                </option>
            </select>
        </div>
        <div class="notesdiv">
            <label for="reminder_notes">Notes:</label>
            <textarea name="reminder_notes" class="remindmeinput" id="notes_textarea" rows="5" cols="50"><%= processed.notes %></textarea>
        </div>
        <% if (!locals.loggedIn) { %>
            <div>
                <label for="email_input">Email</label>
                <input class="remindmeinput" type="email" id="email_input" name="email" required>
            </div>
        <% } %>
        <% if (locals.edit) { %>
            <div class="buttondiv">
                <button type="submit" name="action">Save</button>
                <button id="delete_button" type="button">&nbsp;Delete&nbsp;</button>
                <button id="sure_button" type="submit" name="action"
                        value="delete"
                        class="hiddenbutton">Delete?</button>
                <button id="cancel_button" type="button">Cancel</button>
            </div>
        <% } else { %>
            <button type="submit">Lodge it!!!!</button>
        <% } %>
    </form>
</div>

