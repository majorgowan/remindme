<div class="calendar" id="calendar_div">
    <div class="calendarmode_div">
        <button id="listview_button" class="insidebutton <%- (locals.viewMode === "list") ? "selectedbutton" : "" %>">List View</button>
        <button id="weekview_button" class="insidebutton <%- (locals.viewMode === "week") ? "selectedbutton" : "" %>">Week View</button>
    </div>
    <div id="calendar_listview_div" class="<%- (locals.viewMode !== "list") ? "hiddenview" : ""%>">
        <div class="calendarsearch">
            <input type="text" class="remindmeinput" id="searchbar" placeholder="search">
        </div>
        <table class="calendartable">
            <% for (week in reminders) { %>
                <tbody class="calendarweek">
                <% for (day in reminders[week]) { %>
                    <% for ([index, reminder] of reminders[week][day].entries()) { %>
                        <tr data-id="<%= reminder._id.toString() %>"
                            class="reminder <%- (index === 0) ? "headrow" : "" %> <%- reminder.isNext ? "nextreminder" : "" %> reminder_<%- reminder.urgency.replace(" ", "_") %>">
                            <td class="dayname <%- (index === 0) ? "" : "hiddendatecell" %>"
                                title="<%= reminder.day %>"><span><%= reminder.day.slice(0, 2) %></span></td>
                            <td class="shortdate <%- (index === 0) ? "" : "hiddendatecell" %>"><%= reminder.dateString %></td>
                            <td><%= reminder.time %></td>
                            <td class="remindertext">
                                <%= reminder.text %>
                                <!--
                            <span class="repeatsign">
                                <%- `${(reminder.repeat !== "never") ? `${reminder.repeat.toUpperCase().slice(0, 1)}-${reminder.frequency}` : ""}` %>
                            </span>
                            -->
                            </td>
                            <!--
                                <td class="buttoncell">
                                    <button class="editbutton">
                                        <i class="fas fa-pencil-alt"></i>
                                    </button>
                                    <button class="deletebutton">
                                        <i class="fa fa-trash"></i>
                                    </button>
                                </td>
                            -->
                        </tr>
                    <% } %>
                <% } %>
                </tbody>
            <% } %>
        </table>
        <% if (locals.theresMore) { %>
            <div class="calendarmore">
                <a href="/calendar/?endDate=<%= theresMore %>&startDate=<%- startDate || "" %>#page-end">Load more</a>
            </div>
        <% } %>
        <div id="page-end"></div>
    </div>
    <div id="calendar_weekview_div" class="<%- (locals.viewMode === "list") ? "hiddenview" : ""%>">
        <% for ([weekStart, weekdays] of Object.entries(weekdays)) { %>
            <div class="weekview_div">
                <% for (weekday of weekdays) { %>
                    <div class="daycolumn_div <%- (weekday.month === "even") ? "daycolumn_evenmonth" : "daycolumn_oddmonth"%>">
                        <div class="daycolumn_head_div">
                            <div>
                                <%= weekday.day %>
                                <%= weekday.dateString %>
                            </div>
                        </div>
                        <% if (weekStart in reminders && weekday.date in reminders[weekStart]) { %>
                            <table class="calendartable">
                                <% for (reminder of reminders[weekStart][weekday.date]) { %>
                                    <tr data-id="<%= reminder._id.toString() %>"
                                        class="reminder <%- reminder.isNext ? "nextreminder" : "" %> reminder_<%- reminder.urgency.replace(" ", "_") %>">
                                        <td class="reminder_time_column">
                                            <%= reminder.time %>
                                        </td>
                                        <td>
                                            <%= reminder.text %>
                                        </td>
                                    </tr>
                                <% } %>
                            </table>
                        <% } %>
                    </div>
                <% } %>
            </div>
        <% } %>
    </div>
</div>
